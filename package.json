{
  "name": "stillnote",
  "version": "0.2.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "A local macOS meeting notebook powered by your ChatGPT plan",
  "author": "Michael Ma",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --mac dir && node scripts/sign-local.mjs",
    "package:release": "npm run build && electron-builder --mac dir --arm64 && node scripts/sign-local.mjs --ad-hoc && npm run test:package && node scripts/make-installer.mjs",
    "format": "prettier --write app scripts tests index.html package.json",
    "format:check": "prettier --check app scripts tests index.html package.json",
    "icon": "node scripts/make-icon.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:installer": "node scripts/installer-smoke.mjs",
    "signing:setup": "node scripts/setup-signing.mjs",
    "install:app": "node scripts/install-local.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:native": "node scripts/native-audio-test.mjs",
    "test:native:recognize": "node scripts/native-audio-test.mjs --recognize",
    "test:native-scheduler": "node scripts/native-scheduler-test.mjs",
    "test:native:languages": "node scripts/language-eval.mjs",
    "test:claude": "node scripts/claude-smoke.mjs",
    "test:native-lifecycle": "node scripts/native-lifecycle-test.mjs",
    "setup:mac": "bash scripts/setup-mac.sh",
    "test:install": "node scripts/install-smoke.mjs"
  },
  "build": {
    "copyright": "Copyright © 2026 Michael Ma",
    "appId": "local.stillnote.app",
    "productName": "Stillnote",
    "directories": {
      "output": "release.noindex"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "docs/LICENSING.md",
        "to": "docs/LICENSING.md"
      },
      {
        "from": "native/bin/StillnoteCapture",
        "to": "StillnoteCapture"
      },
      {
        "from": "assets/zh_CN.lproj/InfoPlist.strings",
        "to": "zh_CN.lproj/InfoPlist.strings"
      },
      {
        "from": "native/vendor/webrtc-audio-processing",
        "to": "licenses/webrtc-audio-processing",
        "filter": [
          "**/LICENSE",
          "**/COPYING",
          "**/PATENTS",
          "**/AUTHORS"
        ]
      },
      {
        "from": "native/vendor/abseil-cpp",
        "to": "licenses/abseil-cpp",
        "filter": [
          "**/LICENSE",
          "**/COPYING",
          "**/PATENTS",
          "**/AUTHORS"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Stillnote uses your microphone to transcribe meetings on your Mac.",
        "NSSpeechRecognitionUsageDescription": "Stillnote transcribes meeting audio on your Mac.",
        "NSCalendarsFullAccessUsageDescription": "Stillnote reads upcoming meetings from calendars on your Mac, and adds the todos you choose.",
        "NSAudioCaptureUsageDescription": "Stillnote transcribes audio from your meeting apps.",
        "NSCalendarsUsageDescription": "Stillnote reads upcoming meetings from calendars on your Mac, and adds the todos you choose."
      },
      "icon": "assets/icon.icns"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "ical.js": "2.2.1",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
